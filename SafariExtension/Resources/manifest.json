{
  "manifest_version": 3,
  "name": "Pablo Safari",
  "version": "0.1.14",
  "description": "Inspect and control only the Safari tab explicitly unlocked from the toolbar.",
  "icons": {
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Unlock this tab for Pablo",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "32": "icons/toolbar-32.png",
      "38": "icons/toolbar-38.png"
    }
  }
}
